# Local Postgres for development. Create the database with `createdb fuglanofn`,
# then `npm run db:migrate && npm run db:seed`.
DATABASE_URL="postgresql://USER@localhost:5432/fuglanofn?schema=public"

# Origin the cached Wikimedia images are served from. Leave unset locally and
# they come out of public/images/species/ instead.
# NEXT_PUBLIC_IMAGE_BASE="https://pub-1ad2e45445fb4fa2a9357f1a245a98de.r2.dev"

# --- Auth.js, not wired up yet ---
# AUTH_SECRET=""          # openssl rand -base64 32
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_RESEND_KEY=""      # magic-link sender
