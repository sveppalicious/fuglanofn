# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Cached Wikimedia images, and the full-size JPEG masters they are derived from.
# Reproducible from site-data/images.json, which IS committed and is the part
# that matters. The masters exist so the renditions can be re-cut at different
# sizes without another multi-hour fetch against Wikimedia — keep them, but they
# are far too large to track.
/public/images/species/
/image-masters/

# fetch_images.py run log and bytecode
/fetch-images.log
__pycache__/
*.py[cod]

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Vendored agent docs that `prisma init` drops in — regenerable, not ours
/.agents/
/.windsurf/
/.claude/skills/
/skills-lock.json
