# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Cached Wikimedia images. A full run is roughly 2,8 GB, and it is reproducible
# from site-data/images.json — which IS committed, and is the part that matters.
# Production serves these from a CDN, not from the repo.
/public/images/species/

# fetch_images.py run log and bytecode
/fetch-images.log
__pycache__/
*.py[cod]

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
